{
  "manifest_version": 3,
  "name": "Geo Guess Demo",
  "version": "0.1",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Predict location" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+G" } }
  }
}